<Window x:Class="UpperMachine.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="摄像头监控"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#212529"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#343A40" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#3E444A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8F9FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#ADB5BD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#20C997" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#0A1414" />
        <SolidColorBrush x:Key="InputBrush" Color="#2B3035" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#495057" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263647" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#151F2A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="#7DE4C2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#72D8B6" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#43AF8B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="摄像头"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox x:Name="CameraComboBox"
                          Width="280"
                          VerticalAlignment="Center" />
                <Button x:Name="StartStopButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="启动"
                        Click="StartStopButton_Click"
                        Margin="12,0,0,0"
                        MinWidth="96" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource ActionButtonStyle}"
                    Content="关闭"
                    Click="CloseWindowButton_Click" />
        </Grid>

        <Border Grid.Row="2"
                Background="#101720"
                BorderBrush="#2A3C4B"
                BorderThickness="1"
                CornerRadius="6">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform" />
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="点击“启动”开启摄像头预览" />
    </Grid>
</Window>
